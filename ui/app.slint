import { Button, CheckBox, ComboBox, ListView, Palette, SpinBox, TabWidget, TextEdit } from "std-widgets.slint";

export enum ServiceView { services, readonly, edit }

export enum Level { neutral, success, error }

export struct ServiceRow {
    name: string,
    status: string,
    pid: string,
    restarts: string,
    exit-code: string,
    controllable: bool,
    running: bool,
}

/// One line of the routes view: a service header or one of its route hosts.
export struct RouteRow {
    header: bool,
    label: string,
    note: string,
    // Empty for headers and wildcard hosts.
    url: string,
    host: string,
    target: string,
    muted: bool,
}

global Colors {
    out property <color> success: Palette.color-scheme == ColorScheme.dark ? #47cd89 : #08752f;
    out property <color> error: Palette.color-scheme == ColorScheme.dark ? #f97066 : #b42318;
    out property <color> muted: Palette.color-scheme == ColorScheme.dark ? #85888e : #98a2b3;
    out property <color> link: Palette.color-scheme == ColorScheme.dark ? #84adff : #175cd3;
    out property <color> warning: Palette.color-scheme == ColorScheme.dark ? #fdb022 : #b54708;

    public pure function level(level: Level) -> brush {
        if level == Level.success {
            return success;
        }
        if level == Level.error {
            return error;
        }
        Palette.foreground
    }

    public pure function status(status: string) -> brush {
        if status == "running" {
            return success;
        }
        if status == "crashed" {
            return error;
        }
        if status == "disabled" || status == "unmanaged" {
            return muted;
        }
        Palette.foreground
    }
}

component Banner inherits Rectangle {
    in property <string> text;
    in property <Level> level;
    visible: text != "";
    height: self.visible ? self.preferred-height : 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: level == Level.error ? Colors.error : Palette.border;
    background: level == Level.error ? Colors.error.transparentize(88%) : Palette.alternate-background;
    HorizontalLayout {
        padding: 6px;
        Text {
            text: root.text;
            wrap: word-wrap;
            color: root.level == Level.error ? Colors.error : Palette.foreground;
        }
    }
}

component HeaderCell inherits Text {
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
}

component Table inherits Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.background;
    clip: true;
}

component ServiceTable inherits Table {
    in property <[ServiceRow]> rows;
    in property <int> selected;
    callback row-clicked(int);
    callback row-double-clicked(int);

    VerticalLayout {
        Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 6px;
                padding-left: 8px;
                spacing: 8px;
                HeaderCell { text: "Service"; horizontal-stretch: 1; }
                HeaderCell { text: "Status"; width: 90px; }
                HeaderCell { text: "PID"; width: 70px; }
                HeaderCell { text: "Restarts"; width: 70px; }
                HeaderCell { text: "Exit code"; width: 70px; }
            }
        }

        ListView {
            for row[index] in root.rows: Rectangle {
                height: 28px;
                background: index == root.selected ? Palette.selection-background : Math.mod(index, 2) == 1 ? Palette.alternate-background : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 8px;
                    Cell {
                        text: row.name;
                        horizontal-stretch: 1;
                        color: index == root.selected ? Palette.selection-foreground : Palette.foreground;
                    }
                    Cell { text: row.status; width: 90px; color: Colors.status(row.status); }
                    Cell { text: row.pid; width: 70px; }
                    Cell { text: row.restarts; width: 70px; }
                    Cell { text: row.exit-code; width: 70px; }
                }
                TouchArea {
                    clicked => {
                        root.row-clicked(index);
                    }
                    double-clicked => {
                        root.row-double-clicked(index);
                    }
                }
            }
        }
    }
}

component RouteTable inherits Table {
    in property <[RouteRow]> rows;
    callback open-url(string);

    VerticalLayout {
        Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 6px;
                padding-left: 8px;
                spacing: 8px;
                HeaderCell { text: "Service / route"; horizontal-stretch: 1; }
                HeaderCell { text: "URL"; horizontal-stretch: 1; }
                HeaderCell { text: "→ proxies to"; width: 200px; }
            }
        }

        ListView {
            for row[index] in root.rows: Rectangle {
                height: 28px;
                background: Math.mod(index, 2) == 1 ? Palette.alternate-background : transparent;
                HorizontalLayout {
                    padding-left: row.header ? 8px : 28px;
                    padding-right: 6px;
                    spacing: 8px;
                    Cell {
                        text: row.header && row.note != "" ? row.label + "  (" + row.note + ")" : row.label;
                        font-weight: row.header ? 700 : 400;
                        color: row.muted ? Colors.muted : Palette.foreground;
                        horizontal-stretch: 1;
                    }
                    Cell {
                        text: row.header ? "" : row.url != "" ? row.url : row.host + "  (wildcard)";
                        color: row.url != "" ? Colors.link : Colors.muted;
                        horizontal-stretch: 1;
                    }
                    Cell {
                        text: row.target;
                        color: row.muted ? Colors.muted : Palette.foreground;
                        width: 200px;
                    }
                }
                if row.url != "": TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-url(row.url);
                    }
                }
            }
        }
    }
}

/// A monospace text view that stays pinned to its last line as text arrives.
component LogView inherits TextEdit {
    read-only: true;
    changed text => {
        // Moving the cursor past the end scrolls the last line into view;
        // TextEdit clamps the offset to the text length.
        self.set-selection-offsets(2147483647, 2147483647);
    }
}

export component ManagerTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray-icon.png");
    tooltip: "Local Dev Proxy";
    callback open-manager();
    callback quit();

    clicked => {
        root.open-manager();
    }

    Menu {
        MenuItem {
            title: "Open Manager";
            activated => {
                root.open-manager();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }
}

export component ManagerWindow inherits Window {
    in property <string> version;
    in property <string> mono-font;
    /// A lifecycle or service action is running in the background.
    in property <bool> busy;
    in-out property <int> current-tab;

    in property <ServiceView> view;
    in property <string> banner;
    in property <Level> banner-level;
    in property <string> status-text;
    in property <Level> status-level;
    in property <[ServiceRow]> services;
    in property <int> selected-service: -1;
    in property <string> config-text;
    in-out property <string> editor-text;
    in property <bool> dirty;

    in property <[string]> log-names;
    in-out property <int> log-index;
    in-out property <int> log-lines: 200;
    in-out property <bool> log-follow;
    in property <string> log-text;

    in property <[RouteRow]> routes;
    in property <string> routes-banner;

    callback quit();
    callback toggle-view-config();
    callback stop-to-edit();
    callback start-all();
    callback validate();
    callback save();
    callback reload-config();
    callback editor-edited(string);
    callback service-selected(int);
    callback start-service();
    callback stop-service();
    callback restart-service();
    callback open-service-logs(int);
    callback log-selected();
    callback refresh-logs();
    callback reload-routes();
    callback tab-changed(int);

    changed current-tab => {
        root.tab-changed(root.current-tab);
    }

    private property <bool> has-selection: selected-service >= 0 && selected-service < services.length;
    private property <ServiceRow> selection: services[selected-service];
    private property <bool> can-control: has-selection && selection.controllable && !busy;

    title: "Local Dev Proxy — Manager v" + version;
    icon: @image-url("../assets/dock-icon.png");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 500px;

    MenuBar {
        // The native macOS menu bar carries the standard Quit shortcut; other
        // platforms keep the in-window Quit button and only gain the shortcut.
        visible: Platform.os == OperatingSystemType.macos;
        Menu {
            title: "File";
            MenuItem {
                title: "Quit";
                shortcut: @keys(Control + Q);
                activated => {
                    root.quit();
                }
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        padding-top: 10px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: "v" + root.version;
                color: Colors.muted;
                vertical-alignment: center;
            }

            Rectangle { }

            Button {
                text: "Quit";
                clicked => {
                    root.quit();
                }
            }
        }

        TabWidget {
            current-index <=> root.current-tab;

            Tab {
                title: "Services";
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Banner {
                        text: root.banner;
                        level: root.banner-level;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        if root.view != ServiceView.edit: Button {
                            text: root.view == ServiceView.readonly ? "Back to Services" : "View Config";
                            enabled: !root.busy;
                            clicked => {
                                root.toggle-view-config();
                            }
                        }
                        if root.view == ServiceView.readonly: Button {
                            text: "Stop All & Edit Config";
                            enabled: !root.busy;
                            clicked => {
                                root.stop-to-edit();
                            }
                        }
                        if root.view == ServiceView.edit: Button {
                            text: "Start All";
                            primary: true;
                            enabled: !root.busy;
                            clicked => {
                                root.start-all();
                            }
                        }
                        Rectangle { }

                        Text {
                            text: root.status-text;
                            color: Colors.level(root.status-level);
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    if root.view == ServiceView.services: VerticalLayout {
                        spacing: 8px;
                        ServiceTable {
                            vertical-stretch: 1;
                            rows: root.services;
                            selected: root.selected-service;
                            row-clicked(index) => {
                                root.service-selected(index);
                            }
                            row-double-clicked(index) => {
                                root.open-service-logs(index);
                            }
                        }

                        Rectangle {
                            border-width: 1px;
                            border-radius: 4px;
                            border-color: Palette.border;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text {
                                    font-weight: 600;
                                    text: !root.has-selection ? "Selected service — click a row to control it" : root.selection.controllable ? "Selected service: \{root.selection.name} (\{root.selection.status})" : "Selected service: \{root.selection.name} (\{root.selection.status} — not controllable)";
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: "Start";
                                        enabled: root.can-control && !root.selection.running;
                                        clicked => {
                                            root.start-service();
                                        }
                                    }

                                    Button {
                                        text: "Stop";
                                        enabled: root.can-control && root.selection.running;
                                        clicked => {
                                            root.stop-service();
                                        }
                                    }

                                    Button {
                                        text: "Restart";
                                        enabled: root.can-control && root.selection.running;
                                        clicked => {
                                            root.restart-service();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.view == ServiceView.readonly: TextEdit {
                        accessible-label: "Configuration";
                        vertical-stretch: 1;
                        read-only: true;
                        wrap: no-wrap;
                        font-family: root.mono-font;
                        text: root.config-text;
                    }

                    if root.view == ServiceView.edit: VerticalLayout {
                        spacing: 8px;
                        TextEdit {
                            accessible-label: "Configuration editor";
                            vertical-stretch: 1;
                            wrap: no-wrap;
                            font-family: root.mono-font;
                            enabled: !root.busy;
                            text <=> root.editor-text;
                            edited(text) => {
                                root.editor-edited(text);
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Validate";
                                enabled: !root.busy;
                                clicked => {
                                    root.validate();
                                }
                            }

                            Button {
                                text: "Save";
                                enabled: !root.busy;
                                clicked => {
                                    root.save();
                                }
                            }

                            Button {
                                text: "Reload from disk";
                                enabled: !root.busy;
                                clicked => {
                                    root.reload-config();
                                }
                            }

                            Rectangle { }

                            if root.dirty: Text {
                                text: "● unsaved changes";
                                color: Colors.warning;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Logs";
                if root.view == ServiceView.edit: Text {
                    text: "Unavailable while editing the configuration.";
                    color: Colors.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if root.view != ServiceView.edit: VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Service:";
                            vertical-alignment: center;
                        }

                        ComboBox {
                            width: 220px;
                            model: root.log-names;
                            current-index <=> root.log-index;
                            selected => {
                                root.log-selected();
                            }
                        }

                        Text {
                            text: "Lines:";
                            vertical-alignment: center;
                        }

                        SpinBox {
                            width: 110px;
                            minimum: 10;
                            maximum: 5000;
                            step-size: 10;
                            value <=> root.log-lines;
                            edited => {
                                root.refresh-logs();
                            }
                        }

                        CheckBox {
                            text: "Follow";
                            checked <=> root.log-follow;
                            toggled => {
                                if self.checked {
                                    root.refresh-logs();
                                }
                            }
                        }

                        Rectangle { }

                        Button {
                            text: "Refresh";
                            clicked => {
                                root.refresh-logs();
                            }
                        }
                    }

                    LogView {
                        accessible-label: "Service log";
                        vertical-stretch: 1;
                        font-family: root.mono-font;
                        text: root.log-text;
                    }
                }
            }

            Tab {
                title: "Routes";
                if root.view == ServiceView.edit: Text {
                    text: "Unavailable while editing the configuration.";
                    color: Colors.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if root.view != ServiceView.edit: VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Routes are grouped by service. Click a URL row to open it.";
                        wrap: word-wrap;
                    }

                    Banner {
                        text: root.routes-banner;
                        level: Level.error;
                    }

                    RouteTable {
                        vertical-stretch: 1;
                        rows: root.routes;
                        open-url(url) => {
                            Platform.open-url(url);
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Reload";
                            clicked => {
                                root.reload-routes();
                            }
                        }
                    }
                }
            }
        }
    }
}
